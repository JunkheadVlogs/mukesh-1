# ----------------------------------------------------------------------
# 1. GZIP & Brotli Compression
# ----------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json application/vnd.ms-fontobject application/x-font-ttf image/svg+xml font/opentype font/ttf font/eot font/otf image/x-icon
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json application/vnd.ms-fontobject application/x-font-ttf image/svg+xml font/opentype font/ttf font/eot font/otf image/x-icon
</IfModule>

# ----------------------------------------------------------------------
# 2. Expires Headers (Browser Caching)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & JSON: short/no-cache so new deployments update immediately
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"

  # Hashed JavaScript & CSS
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images & Icons
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

  # Web Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType application/x-font-woff "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# 3. Cache-Control & Security Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Hashed /assets/*.js and /assets/*.css + Fonts + Images: 1 year immutable
  <FilesMatch "\.(js|css|jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML files: no-cache, must-revalidate so fresh deployments are fetched instantly
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Service worker script: do not cache to allow immediate SW updates
  <FilesMatch "(sw|service-worker)\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Robots-Tag "index, follow"
</IfModule>

RewriteEngine On

# Redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Prevent direct access to raw development files / source code
RewriteRule ^src/ - [F,L]
RewriteRule ^scripts/ - [F,L]
RewriteRule \.(tsx|ts|json|config|env|rules|gs|example)$ - [F,L]
RewriteRule ^(package\.json|package-lock\.json|tsconfig\.json|vite\.config\.ts|server\.ts|AGENTS\.md|DEPLOYMENT\.md|nginx\.conf)$ - [F,L]

# Redirect root domain to dist/index.html
RewriteCond %{REQUEST_URI} ^/$ [NC]
RewriteRule ^$ dist/index.html [L]

# Serve pre-rendered folders if they exist
RewriteCond %{DOCUMENT_ROOT}/dist/$1/index.html -f
RewriteRule ^([^/]+)/?$ dist/$1/index.html [L]

# Serve pre-rendered product pages
RewriteCond %{DOCUMENT_ROOT}/dist/product/$1/index.html -f
RewriteRule ^product/([^/]+)/?$ dist/product/$1/index.html [L]

# General file rewrite map to dist
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
RewriteRule ^(.*)$ dist/$1 [L]

# SPA Rewrite: Default all other routes to dist/index.html
RewriteCond %{REQUEST_URI} !^/dist/
RewriteRule ^(.*)$ dist/index.html [L]
